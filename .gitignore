# Allowlist-style ignore: everything is ignored unless negated below.
# CAUTION: a new top-level file/dir (or a new file type in a partially
# negated dir) is INVISIBLE to `git status` until it gets a negation here.
# Prefer directory-wide globs over per-file entries so additions in
# already-tracked areas show up automatically.
*
*/

!.gitignore
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.github/ISSUE_TEMPLATE/
!.github/ISSUE_TEMPLATE/**
!.github/FUNDING.yml
!README.adoc
!docs/
!docs/*.adoc
!secrets-example.yaml
!cove-minimal-dishwasher.yaml
!wolf-minimal-range.yaml
!wolf-minimal-fridge.yaml
!ci-fridge-write-support.yaml
!components/
!components/patch_acl_reassembly/
!components/patch_acl_reassembly/**
!components/subzero_protocol/
!components/subzero_protocol/**
!components/subzero_appliance/
!components/subzero_appliance/**
!tests/
!tests/fixtures/
!tests/fixtures/**
!tests/cpp/
!tests/cpp/CMakeLists.txt
!tests/cpp/*.cpp
!tests/cpp/*.h

# Re-ignore caches/artifacts that the broad ** allows would otherwise let through.
# Last-matching-rule wins in gitignore, so these override the negations above.
__pycache__/
*.pyc
.DS_Store
